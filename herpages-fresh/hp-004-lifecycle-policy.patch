+  it("rejects self-approval (proposed -> active)", () => {
+    expect(() => nextRelationshipState("proposed", "active")).toThrow();
+  });
+
+  it("revoked is terminal", () => {
+    expect(() => nextRelationshipState("revoked", "active")).toThrow();
+  });
