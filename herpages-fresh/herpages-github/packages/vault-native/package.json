{
  "name": "@herpages/vault-native",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@herpages/contracts": "workspace:*",
    "@herpages/vault-port": "workspace:*"
  },
  "peerDependencies": {
    "expo-crypto": "~57.0.0",
    "expo-secure-store": "~57.0.0",
    "expo-sqlite": "~57.0.0"
  },
  "peerDependenciesMeta": {
    "expo-crypto": { "optional": true },
    "expo-secure-store": { "optional": true },
    "expo-sqlite": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
