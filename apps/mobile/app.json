{
  "expo": {
    "name": "HerPages",
    "slug": "herpages",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "herpages",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.herpages.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF8FC"
      },
      "package": "com.herpages.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ]
    ]
  }
}
