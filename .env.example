# HerPages — environment variable names only, no secrets.
# Copy to .env and fill in values for local development.

# Supabase (service data, not vault content)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# API server
API_PORT=3001
API_HOST=0.0.0.0

# Feature flags environment (see contracts/feature-flags.json)
FEATURE_ENV=development
