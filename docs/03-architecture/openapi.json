{
  "openapi":"3.1.0",
  "info":{"title":"HerPages connected-service contract","version":"1.0.0-draft","description":"Design contract only; no API deployed. Private Page CRUD is deliberately absent. All mutations enforce fresh subject/resource authority, consent and release gates beyond token authentication."},
  "servers":[{"url":"https://api.herpages.invalid","description":"Reserved non-operational documentation domain"}],
  "security":[{"bearerAuth":[]}],
  "paths":{
    "/v1/catalog/opportunities":{"get":{"operationId":"listPublishedOpportunities","security":[],"parameters":[{"name":"cursor","in":"query","schema":{"type":"string","maxLength":256}},{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":50,"default":20}}],"responses":{"200":{"description":"Published metadata only; personal matching stays local","content":{"application/json":{"schema":{"type":"object","required":["items","next_cursor"],"properties":{"items":{"type":"array","items":{"$ref":"../../contracts/opportunity.schema.json"}},"next_cursor":{"type":["string","null"]}}}}}},"default":{"$ref":"#/components/responses/Error"}}}},
    "/v1/me/capabilities":{"get":{"operationId":"getCurrentCapabilities","responses":{"200":{"description":"Fresh server policy; cache cannot authorize a server mutation","content":{"application/json":{"schema":{"type":"object","required":["policy_version","capabilities","expires_at"],"properties":{"policy_version":{"type":"string"},"capabilities":{"type":"array","items":{"type":"string"}},"expires_at":{"type":"string","format":"date-time"}}}}}},"default":{"$ref":"#/components/responses/Error"}}}},
    "/v1/consents":{"post":{"operationId":"recordConsent","description":"Requires approved actor-subject authority and assurance; payload cannot establish guardianship.","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ConsentCommand"}}}},"responses":{"201":{"description":"Recorded receipt","content":{"application/json":{"schema":{"$ref":"../../contracts/consent-receipt.schema.json"}}}},"default":{"$ref":"#/components/responses/Error"}}}},
    "/v1/consents/{id}/withdraw":{"parameters":[{"$ref":"#/components/parameters/Id"}],"post":{"operationId":"withdrawConsent","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"responses":{"202":{"description":"Withdrawal registered; new dependent disclosures denied and cleanup queued","content":{"application/json":{"schema":{"$ref":"#/components/schemas/JobReceipt"}}}},"default":{"$ref":"#/components/responses/Error"}}}},
    "/v1/vaults/{id}/snapshots":{"parameters":[{"$ref":"#/components/parameters/Id"}],"get":{"operationId":"listAuthorizedSnapshots","parameters":[{"name":"cursor","in":"query","schema":{"type":"string"}}],"responses":{"200":{"description":"Authorized ciphertext metadata only","content":{"application/json":{"schema":{"type":"object","properties":{"items":{"type":"array","items":{"$ref":"#/components/schemas/SnapshotReceipt"}},"next_cursor":{"type":["string","null"]}}}}}},"default":{"$ref":"#/components/responses/Error"}}},"post":{"operationId":"createSnapshot","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["snapshot_id","device_id","expected_sequence"],"properties":{"snapshot_id":{"type":"string","format":"uuid"},"device_id":{"type":"string","format":"uuid"},"expected_sequence":{"type":"integer","minimum":0}}}}}},"responses":{"201":{"description":"Draft snapshot; not yet backed up","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SnapshotReceipt"}}}},"409":{"description":"Stale expected head","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"default":{"$ref":"#/components/responses/Error"}}}},
    "/v1/vaults/{id}/snapshots/{snapshotId}/upload-grants":{"parameters":[{"$ref":"#/components/parameters/Id"},{"$ref":"#/components/parameters/SnapshotId"}],"post":{"operationId":"createUploadGrants","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["objects"],"properties":{"objects":{"type":"array","minItems":1,"maxItems":100,"items":{"$ref":"#/components/schemas/CipherObjectDescriptor"}}}}}}},"responses":{"200":{"description":"Short-lived scoped upload capabilities; never log URLs","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GrantList"}}}},"default":{"$ref":"#/components/responses/Error"}}}},
    "/v1/vaults/{id}/snapshots/{snapshotId}/finalize":{"parameters":[{"$ref":"#/components/parameters/Id"},{"$ref":"#/components/parameters/SnapshotId"}],"post":{"operationId":"finalizeSnapshot","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["expected_sequence","encrypted_manifest_object_id"],"properties":{"expected_sequence":{"type":"integer","minimum":0},"encrypted_manifest_object_id":{"type":"string","format":"uuid"}}}}}},"responses":{"200":{"description":"Finalized only after object-integrity checks and atomic head update","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SnapshotReceipt"}}}},"409":{"description":"Head conflict; preserve both branches","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"default":{"$ref":"#/components/responses/Error"}}}},
    "/v1/vaults/{id}/snapshots/{snapshotId}/download-grants":{"parameters":[{"$ref":"#/components/parameters/Id"},{"$ref":"#/components/parameters/SnapshotId"}],"post":{"operationId":"createDownloadGrants","description":"Fresh device/epoch/owner authorization required; a service login alone is insufficient.","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"responses":{"200":{"description":"Bounded ciphertext download capabilities","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GrantList"}}}},"default":{"$ref":"#/components/responses/Error"}}}},
    "/v1/devices/{id}/revoke":{"parameters":[{"$ref":"#/components/parameters/Id"}],"post":{"operationId":"revokeDevice","description":"Fresh step-up authentication required. Does not erase offline copies.","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"responses":{"202":{"description":"Revocation registered","content":{"application/json":{"schema":{"$ref":"#/components/schemas/JobReceipt"}}}},"default":{"$ref":"#/components/responses/Error"}}}},
    "/v1/privacy/deletions":{"post":{"operationId":"requestDeletion","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["scope","resource_id"],"properties":{"scope":{"enum":["account","vault_backup","application","community_content"]},"resource_id":{"type":"string","format":"uuid"}}}}}},"responses":{"202":{"description":"Class-specific deletion review/cleanup; legal holds and existing copies explained","content":{"application/json":{"schema":{"$ref":"#/components/schemas/JobReceipt"}}}},"default":{"$ref":"#/components/responses/Error"}}}},
    "/v1/organizations/{id}/opportunities":{"parameters":[{"$ref":"#/components/parameters/Id"}],"post":{"operationId":"createOrganizationOpportunityDraft","description":"Organization-scoped authoring only. Server forces draft and assigns review state.","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"../../contracts/opportunity.schema.json"}}}},"responses":{"201":{"description":"Draft created, not published","content":{"application/json":{"schema":{"$ref":"../../contracts/opportunity.schema.json"}}}},"default":{"$ref":"#/components/responses/Error"}}}},
    "/v1/opportunities/{id}/publish":{"parameters":[{"$ref":"#/components/parameters/Id"}],"post":{"operationId":"publishReviewedOpportunity","description":"Authorized independent editor only; verifies required evidence and current source.","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"responses":{"200":{"description":"Published reviewed listing","content":{"application/json":{"schema":{"$ref":"../../contracts/opportunity.schema.json"}}}},"default":{"$ref":"#/components/responses/Error"}}}},
    "/v1/ai/requests":{"post":{"operationId":"requestAdultSelectedAssistance","description":"Disabled baseline. Reject minor personal input or absent purpose/consent/provider approval before forwarding. No arbitrary tools.","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["purpose","consent_receipt_id","selected_text","source_ids"],"properties":{"purpose":{"enum":["explain_opportunity","adult_goal_planning"]},"consent_receipt_id":{"type":"string","format":"uuid"},"selected_text":{"type":"string","maxLength":12000},"source_ids":{"type":"array","maxItems":10,"items":{"type":"string"}}}}}}},"responses":{"200":{"description":"Validated draft; references must be supplied authorized sources","content":{"application/json":{"schema":{"type":"object","required":["draft","source_ids","limitations"],"properties":{"draft":{"type":"string"},"source_ids":{"type":"array","items":{"type":"string"}},"limitations":{"type":"array","items":{"type":"string"}}}}}}},"default":{"$ref":"#/components/responses/Error"}}}}
  },
  "components":{
    "securitySchemes":{"bearerAuth":{"type":"http","scheme":"bearer","bearerFormat":"JWT"}},
    "parameters":{
      "Id":{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},
      "SnapshotId":{"name":"snapshotId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},
      "IdempotencyKey":{"name":"Idempotency-Key","in":"header","required":true,"schema":{"type":"string","minLength":8,"maxLength":128}}
    },
    "responses":{"Error":{"description":"Sanitized error; no private text, keys or cross-user enumeration","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}}},
    "schemas":{
      "Error":{"type":"object","additionalProperties":false,"required":["code","message","request_id"],"properties":{"code":{"enum":["UNAUTHENTICATED","FORBIDDEN","ASSURANCE_REQUIRED","CONSENT_REQUIRED","FEATURE_DISABLED","VALIDATION_ERROR","CONFLICT","RATE_LIMITED","DEPENDENCY_UNAVAILABLE","INTEGRITY_FAILURE"]},"message":{"type":"string"},"request_id":{"type":"string"},"retry_after_seconds":{"type":"integer","minimum":0}}},
      "ConsentCommand":{"type":"object","additionalProperties":false,"required":["subject_id","purpose","notice_version","assurance_reference"],"properties":{"subject_id":{"type":"string","format":"uuid"},"purpose":{"enum":["service_account","child_history","encrypted_backup","minor_participation","program_application","adult_community","adult_ai_selected","adult_safety_session"]},"notice_version":{"type":"string"},"assurance_reference":{"type":"string"}}},
      "JobReceipt":{"type":"object","required":["request_id","state"],"properties":{"request_id":{"type":"string","format":"uuid"},"state":{"enum":["accepted","processing","completed","held","failed"]}}},
      "SnapshotReceipt":{"type":"object","required":["snapshot_id","sequence","state"],"properties":{"snapshot_id":{"type":"string","format":"uuid"},"sequence":{"type":"integer","minimum":1},"state":{"enum":["draft","uploading","finalized","failed","conflict"]}}},
      "CipherObjectDescriptor":{"type":"object","additionalProperties":false,"required":["object_id","byte_length","ciphertext_sha256"],"properties":{"object_id":{"type":"string","format":"uuid"},"byte_length":{"type":"integer","minimum":1,"maximum":10485760},"ciphertext_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},
      "GrantList":{"type":"object","required":["grants"],"properties":{"grants":{"type":"array","items":{"type":"object","required":["object_id","url","expires_at"],"properties":{"object_id":{"type":"string","format":"uuid"},"url":{"type":"string","format":"uri"},"expires_at":{"type":"string","format":"date-time"}}}}}}
    }
  }
}
